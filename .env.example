# Copy file này thành .env và chỉnh theo môi trường của bạn.
# docker compose tự đọc file .env cùng thư mục.

# ===== Domain =====
# Subdomain công khai của dự án (dùng cho CORS)
PUBLIC_URL=https://usth.laviehanoi.com

# ===== Docker network dùng chung =====
# Network chứa MySQL web_mysql và nginx. Kiểm tra tên thật: docker network ls
WEB_NETWORK=kien_webnet

# ===== MySQL =====
# Trên server: trỏ tới container MySQL có sẵn (web_mysql).
# DB_PORT là cổng NỘI BỘ của container MySQL, không phải cổng map ra host.
DB_HOST=web_mysql
DB_PORT=3306
DB_NAME=usth_aviation
DB_USERNAME=root
DB_PASSWORD=HAILONG_DEV

# Chỉ dùng khi chạy local với docker-compose.local.yml
# (cổng MySQL riêng map ra host)
MYSQL_HOST_PORT=3307

# ===== Backend =====
# Cổng HTTP trong container. Đổi cả proxy_pass trong deploy/nginx-usth.conf nếu đổi.
SERVER_PORT=8090
# Cổng map ra host (server bind vào 127.0.0.1, truy cập công khai qua nginx)
HOST_PORT=8090

# BẮT BUỘC đổi khi triển khai thật (>= 32 ký tự cho HS256)
JWT_SECRET=USTH_Aviation_Society_Secret_Key_2026_123456789

# Origin được phép gọi API. Trên server chỉ cần domain công khai.
CORS_ALLOWED_ORIGINS=https://usth.laviehanoi.com

# ===== JPA =====
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
