# Copy file này thành .env và chỉnh theo môi trường của bạn.
# docker compose tự đọc file .env cùng thư mục.

# ===== MySQL =====
DB_NAME=usth_aviation
DB_USERNAME=root
DB_PASSWORD=HAILONG_DEV
DB_PORT=3307

# ===== Backend =====
SERVER_PORT=8080

# BẮT BUỘC đổi khi triển khai thật (>= 32 ký tự cho HS256)
JWT_SECRET=USTH_Aviation_Society_Secret_Key_2026_123456789

# "*" = cho phép tất cả, hoặc danh sách phân tách bằng dấu phẩy
CORS_ALLOWED_ORIGINS=*

# ===== JPA =====
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
